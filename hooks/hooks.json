{
  "description": "Require resource classification for every task and route GPU work through compute orchestration.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route_training_prompt.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/block_portal_bash.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_compute-orchestrator_res|res)__ensure_resource",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_session_id.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
